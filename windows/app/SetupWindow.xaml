<Window Icon="Streamsthetic.ico" x:Class="PhoneCam.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skin="clr-namespace:PhoneCam"
        Title="Get started - Streamsthetic" Width="560" SizeToContent="Height" ResizeMode="CanResize"
        MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource SansFont}" Background="{DynamicResource PaperBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <TextBlock Text="Streamsthetic  ·  Setup" Style="{StaticResource HeaderKey}" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Get started" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text=" /" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Body}" Margin="0,6,0,16"
                   Text="Connect your Android phone by USB or Wi-Fi. You can reopen this guide in Settings." />

        <HeaderedContentControl Style="{StaticResource InstrumentPanel}" Tag="01"
                                skin:Skin.SectionBrush="{DynamicResource Section1Brush}" skin:Skin.PanelFill="{DynamicResource Panel1Brush}" skin:Skin.Glyph="{DynamicResource Icon1}">
            <HeaderedContentControl.Header><TextBlock Text="Connect by USB" Style="{StaticResource PanelTitle}" /></HeaderedContentControl.Header>
            <StackPanel>
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,10">
                    <Run FontWeight="SemiBold" Text="1.  Open Streamsthetic on your phone" /><LineBreak />
                    <Run Text="Allow camera access and choose USB connection." />
                </TextBlock>
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,10">
                    <Run FontWeight="SemiBold" Text="2.  Plug in a USB data cable" /><LineBreak />
                    <Run Text="On the phone, tap Show the setup guide to turn on USB tethering. Choose USB connection in the PC app too. No pairing code is needed." />
                </TextBlock>
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap">
                    <Run FontWeight="SemiBold" Text="3.  Press Start on your phone" /><LineBreak />
                    <Run Text="The PC connects automatically when enabled. If it does not connect, press Start on the PC." />
                </TextBlock>
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource InstrumentPanel}" Tag="02"
                                skin:Skin.SectionBrush="{DynamicResource Section2Brush}" skin:Skin.PanelFill="{DynamicResource Panel2Brush}" skin:Skin.Glyph="{DynamicResource Icon2}">
            <HeaderedContentControl.Header><TextBlock Text="Prefer Wi-Fi?" Style="{StaticResource PanelTitle}" /></HeaderedContentControl.Header>
            <StackPanel>
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap" Margin="0,0,0,10"
                           Text="Connect both devices to the same network. Your PC can use Wi-Fi or Ethernet." />
                <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                           Text="Choose Wi-Fi in both apps. On your phone, tap Scan QR code from the PC and scan the code shown on the PC. Then press Start on your phone. If it does not connect automatically, press Start on the PC." />
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource InstrumentPanel}" Tag="03"
                                skin:Skin.SectionBrush="{DynamicResource Section3Brush}" skin:Skin.PanelFill="{DynamicResource Panel3Brush}" skin:Skin.Glyph="{DynamicResource Icon3}">
            <HeaderedContentControl.Header><TextBlock Text="Use your camera" Style="{StaticResource PanelTitle}" /></HeaderedContentControl.Header>
            <TextBlock Style="{StaticResource Body}" TextWrapping="Wrap"
                       Text="In OBS or your video app, choose Streamsthetic (Windows Virtual Camera). Add more phones from the Phones tab; they appear as Streamsthetic 2, 3 and 4." />
        </HeaderedContentControl>
        <TextBlock Style="{StaticResource RowHint}" Margin="0,0,0,14"
                   Text="USB debugging is an optional alternative under Connection, Advanced. It is not needed for the USB connection described above." />
        <Button Content="Got it" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnClose" />
    </StackPanel>
    </ScrollViewer>
</Window>
