<Window Icon="Streamsthetic.ico" x:Class="PhoneCam.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skin="clr-namespace:PhoneCam"
        Title="Report a problem - Streamsthetic" Width="520" SizeToContent="Height" ResizeMode="CanResize" MinWidth="440" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        FontFamily="{StaticResource SansFont}"
        Background="{DynamicResource PaperBrush}">
    <!-- same instrument-panel look as the main window (docs/DESIGN_PATTERNS.md "Redesign", "Secondary windows") -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24">
        <TextBlock Text="Streamsthetic  ·  Report" Style="{StaticResource HeaderKey}" />
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="Report a problem" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource InkBrush}" />
            <TextBlock Text=" /" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>
        <TextBlock Style="{StaticResource Body}" Margin="0,6,0,16"
                   Text="Describe the problem and save diagnostic logs to help investigate it. Phone logs can also be included when USB debugging is connected and authorized." />

        <HeaderedContentControl Style="{StaticResource InstrumentPanel}" Tag="01"
                                skin:Skin.SectionBrush="{DynamicResource Section1Brush}" skin:Skin.PanelFill="{DynamicResource Panel1Brush}" skin:Skin.Glyph="{DynamicResource Icon1}">
            <HeaderedContentControl.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Problem" Style="{StaticResource PanelTitle}" />
                    <TextBlock Style="{StaticResource InfoIcon}"
                               ToolTip="Crashes and unexpected stops that Streamsthetic noticed, newest first. The most recent one is already selected. If what went wrong isn't in the list (for example the picture looked wrong), choose &quot;Something else&quot;." />
                </StackPanel>
            </HeaderedContentControl.Header>
            <ListBox x:Name="ProblemList" Height="124" SelectionChanged="OnProblemChanged" FontFamily="{StaticResource MonoFont}" FontSize="12"
                     ItemContainerStyle="{StaticResource RowItem}"
                     Background="Transparent" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource InstrumentPanel}" Tag="02"
                                skin:Skin.SectionBrush="{DynamicResource Section2Brush}" skin:Skin.PanelFill="{DynamicResource Panel2Brush}" skin:Skin.Glyph="{DynamicResource Icon2}">
            <HeaderedContentControl.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Time range" Style="{StaticResource PanelTitle}" />
                    <TextBlock Style="{StaticResource InfoIcon}"
                               ToolTip="Streamsthetic keeps a record of what it did (connections, settings changes, frame rate every few seconds). The report includes this many minutes leading up to the problem you picked. Longer helps when the trouble built up slowly; shorter keeps the report small." />
                </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="MinutesSlider" skin:Skin.SectionBrush="{DynamicResource SliderReportBrush}" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Value="15"
                            VerticalAlignment="Center" ValueChanged="OnMinutesChanged" />
                    <TextBlock x:Name="MinutesText" Grid.Column="1" MinWidth="80" Margin="12,0,0,0" TextAlignment="Right" Style="{StaticResource MonoValue}" />
                </Grid>
                <TextBlock x:Name="WindowText" Style="{StaticResource MonoLabel}" Margin="0,8,0,0" />
            </StackPanel>
        </HeaderedContentControl>

        <HeaderedContentControl Style="{StaticResource InstrumentPanel}" Tag="03"
                                skin:Skin.SectionBrush="{DynamicResource Section3Brush}" skin:Skin.PanelFill="{DynamicResource Panel3Brush}" skin:Skin.Glyph="{DynamicResource Icon3}">
            <HeaderedContentControl.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="What happened?" Style="{StaticResource PanelTitle}" />
                    <TextBlock Style="{StaticResource InfoIcon}"
                               ToolTip="Anything Streamsthetic can't see for itself: was the cable moved or unplugged, did the phone get hot or lock, which app was using the camera (OBS, Discord...), what did you see on screen. A sentence or two is plenty." />
                </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel>
                <TextBox x:Name="UserText" Height="90" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="13" />
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <CheckBox x:Name="IncludePhoneBox" Content="Include phone logs" IsChecked="True" />
                    <TextBlock Style="{StaticResource InfoIcon}"
                               ToolTip="Adds what the Streamsthetic app on your phone recorded, and any crash Android noted, plus the phone model and Android version. Requires an authorized USB debugging connection. No pictures or video are included." />
                </StackPanel>
                <TextBlock x:Name="PhoneHint" Style="{StaticResource MonoLabel}" Margin="26,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </HeaderedContentControl>

        <Button x:Name="SendButton" Content="Save report and open email" Margin="0,4,0,0" Style="{StaticResource PrimaryButton}" Click="OnSend" />
        <TextBlock x:Name="ResultText" Style="{StaticResource Body}" Foreground="{DynamicResource InkBrush}" Margin="0,12,0,0" />
        <TextBlock x:Name="AddressText" Style="{StaticResource Body}" Margin="0,8,0,0" />
    </StackPanel>
    </ScrollViewer>
</Window>
