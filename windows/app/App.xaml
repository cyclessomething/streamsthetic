<Application x:Class="PhoneCam.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System">
    <!-- Fluent supplies the standard controls (check boxes, sliders, scroll bars, text boxes); Streamsthetic's own look
         (docs/DESIGN_PATTERNS.md "Redesign") sits on top: Theme/Styles.xaml, colors from Theme/Light.xaml or
         Theme/Dark.xaml (App.ApplyTokens swaps them). -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Studio-Light.xaml" />
                <ResourceDictionary Source="Theme/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <!-- Fluent's accent is Windows' (often blue): Streamsthetic's orange instead, for every standard control.
                 Own keys here win over the merged Fluent theme. Ink on orange: white is only 3:1 there. -->
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FE5921" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E6FE5921" />
            <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#CCFE5921" />
            <SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#E2491A" />
            <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#E2491A" />
            <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#E2491A" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#1B1D1F" />
            <SolidColorBrush x:Key="TextOnAccentFillColorSecondaryBrush" Color="#1B1D1F" />
            <Color x:Key="SystemAccentColor">#FE5921</Color>
            <Color x:Key="SystemAccentColorLight1">#FF6E3C</Color>
            <Color x:Key="SystemAccentColorLight2">#FF8A5E</Color>
            <Color x:Key="SystemAccentColorLight3">#FFA987</Color>
            <Color x:Key="SystemAccentColorDark1">#E2491A</Color>
            <Color x:Key="SystemAccentColorDark2">#C23C13</Color>
            <Color x:Key="SystemAccentColorDark3">#A0300E</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
