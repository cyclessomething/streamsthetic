<!-- Streamsthetic's control styles (docs/DESIGN_PATTERNS.md "Implemented system" and "Themes"). Nothing here is hard-coded to
     one look: colours, corner radii, fonts, borders, shadows, icons and text case all come from the active theme's
     token file (Theme/<Theme>-<Light|Dark>.xaml, DynamicResource), so a theme switch repaints everything. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:skin="clr-namespace:PhoneCam">

    <!-- fixed typefaces: sentences are always Archivo; Plex Mono and Doto are also used directly -->
    <FontFamily x:Key="SansFont">pack://application:,,,/Fonts/#Archivo</FontFamily>
    <FontFamily x:Key="MonoFont">pack://application:,,,/Fonts/#IBM Plex Mono</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Doto</FontFamily>

    <!-- ===================== text ===================== -->
    <!-- text shown in CAPITALS or as typed, as the theme says (XAML and code always write natural text) -->
    <Style x:Key="CaseText" TargetType="TextBlock">
        <Setter Property="skin:Skin.Upper" Value="{DynamicResource UpperCase}" />
    </Style>
    <Style x:Key="MonoLabel" TargetType="TextBlock" BasedOn="{StaticResource CaseText}">
        <Setter Property="FontFamily" Value="{DynamicResource LabelFont}" />
        <Setter Property="FontSize" Value="{DynamicResource LabelSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="MonoValue" TargetType="TextBlock" BasedOn="{StaticResource MonoLabel}">
        <Setter Property="skin:Skin.Upper" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style x:Key="PanelTitle" TargetType="TextBlock" BasedOn="{StaticResource CaseText}">
        <Setter Property="FontFamily" Value="{DynamicResource TitleFont}" />
        <Setter Property="FontSize" Value="{DynamicResource TitleSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TitleWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Wordmark" TargetType="TextBlock" BasedOn="{StaticResource CaseText}">
        <Setter Property="FontFamily" Value="{DynamicResource WordmarkFont}" />
        <Setter Property="FontSize" Value="{DynamicResource WordmarkSize}" />
        <Setter Property="FontWeight" Value="{DynamicResource TitleWeight}" />
        <Setter Property="Foreground" Value="{DynamicResource OnHeaderBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Readout" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource ReadoutFont}" />
        <Setter Property="FontWeight" Value="{DynamicResource ReadoutWeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ReadoutSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource ReadoutLine}" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    </Style>
    <Style x:Key="ReadoutUnit" TargetType="TextBlock" BasedOn="{StaticResource MonoLabel}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="6,0,0,6" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="HeaderKey" TargetType="TextBlock" BasedOn="{StaticResource MonoLabel}">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>

    <!-- (i) next to every option: plain-language explanation on hover or keyboard focus, also while disabled -->
    <Style x:Key="InfoIcon" TargetType="TextBlock">
        <Setter Property="Text" Value="&#xE946;" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="6,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource Ink3Brush}" />
        <Setter Property="Cursor" Value="Help" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        <Setter Property="ToolTipService.ShowDuration" Value="60000" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="{StaticResource SansFont}" FontSize="12.5" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- a row label: text + (i) -->
    <Style x:Key="RowLabel" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <!-- ===================== panels ===================== -->
    <!-- A numbered panel: the header (Header) has an accent bar (Studio, Gamer, Brutal) or a coloured icon (Creator), the
         index (Tag) sits at the right. Skin.SectionBrush / Skin.Glyph set per panel; Gamer adds corner brackets and a star. -->
    <Style x:Key="InstrumentPanel" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <!-- Prism: the light half of the soft raised look (the dark half is the Effect on the border above it) -->
                        <Border Background="{Binding Path=(skin:Skin.PanelFill), RelativeSource={RelativeSource TemplatedParent}}"
                                CornerRadius="{DynamicResource PanelCorner}" Effect="{DynamicResource PanelEffectLight}" />
                        <Border Background="{Binding Path=(skin:Skin.PanelFill), RelativeSource={RelativeSource TemplatedParent}}" BorderBrush="{DynamicResource PanelStrokeBrush}"
                                BorderThickness="{DynamicResource PanelBorder}" CornerRadius="{DynamicResource PanelCorner}"
                                Effect="{DynamicResource PanelEffect}" Padding="18,16,18,18">
                            <DockPanel>
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="3" Height="13" VerticalAlignment="Center"
                                               Fill="{Binding Path=(skin:Skin.SectionBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                               Visibility="{DynamicResource AccentBarVisibility}" />
                                    <TextBlock Text="{Binding Path=(skin:Skin.Glyph), RelativeSource={RelativeSource TemplatedParent}}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center"
                                               Foreground="{Binding Path=(skin:Skin.SectionBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                               Visibility="{DynamicResource IconVisibility}" />
                                    <ContentPresenter Grid.Column="1" ContentSource="Header" Margin="{DynamicResource HeaderIndent}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                        <TextBlock Text="&#x2726;" Foreground="{DynamicResource AccentBrush}" FontSize="11" Margin="0,0,6,0"
                                                   FontFamily="Segoe UI Symbol" VerticalAlignment="Center" Visibility="{DynamicResource StarVisibility}" />
                                        <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource MonoLabel}" Foreground="{DynamicResource Ink3Brush}" />
                                    </StackPanel>
                                </Grid>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <!-- Gamer: corner brackets -->
                        <Grid Visibility="{DynamicResource BracketVisibility}" IsHitTestVisible="False">
                            <Path Data="M0,10 L0,0 L10,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-1" />
                            <Path Data="M0,0 L10,0 L10,10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="-1" />
                            <Path Data="M0,0 L0,10 L10,10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-1" />
                            <Path Data="M10,0 L10,10 L0,10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="-1" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== chips ===================== -->
    <!-- a choice of 2-5 options shown all at once; the chosen chip is filled with its panel's colour -->
    <Style x:Key="Chip" TargetType="ListBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource ChipFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Lit" Margin="-3" Opacity="0" IsHitTestVisible="False" CornerRadius="{DynamicResource ChipCorner}" Background="{Binding Path=(skin:Skin.SectionBrush), RelativeSource={RelativeSource TemplatedParent}}"><Border.Effect><BlurEffect Radius="10" /></Border.Effect></Border>
                        <Border x:Name="Chrome" Background="{DynamicResource ChipFillBrush}" BorderBrush="{DynamicResource ChipStrokeBrush}"
                                BorderThickness="{DynamicResource ChipBorder}" CornerRadius="{DynamicResource ChipCorner}" Effect="{DynamicResource ChipEffect}" />
                        <Border x:Name="Preview" Opacity="0" IsHitTestVisible="False" CornerRadius="{DynamicResource ChipCorner}"
                                Background="{Binding Path=(skin:Skin.SectionBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                        <Border x:Name="Selected" Visibility="Collapsed" CornerRadius="{DynamicResource ChipCorner}"
                                Background="{Binding Path=(skin:Skin.SectionBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="10,5" MinWidth="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.ContentTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource CaseText}" TextAlignment="Center" />
                                </DataTemplate>
                            </ContentPresenter.ContentTemplate>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SectionInkBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Preview" Storyboard.TargetProperty="Opacity" To="0.9" Duration="0:0:0.12" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Preview" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" FillBehavior="Stop" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" /></Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Lit" Property="Opacity" Value="0.55" />
                            <Setter Property="Foreground" Value="{DynamicResource SectionInkBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Lit" Storyboard.TargetProperty="Opacity" From="1" To="0.55" Duration="0:0:0.5" FillBehavior="Stop" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ChipList" TargetType="ListBox">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Chip}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== buttons ===================== -->
    <!-- quiet button: outlined (Reset, Left, Right); put TextBlocks with Style CaseText inside -->
    <Style x:Key="GhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource ChipFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ToolTipService.ShowOnDisabled" Value="True" />
        <Setter Property="ToolTipService.InitialShowDelay" Value="150" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid><Border x:Name="Glow" Margin="-4" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource AccentBrush}" CornerRadius="{DynamicResource ChipCorner}"><Border.Effect><BlurEffect Radius="12" /></Border.Effect></Border><Border x:Name="Chrome" Background="{DynamicResource ChipFillBrush}" BorderBrush="{DynamicResource ChipStrokeBrush}"
                            BorderThickness="{DynamicResource ChipBorder}" CornerRadius="{DynamicResource ChipCorner}" Padding="9,4" Effect="{DynamicResource ChipEffect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border></Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChipHoverBrush}" /><Setter TargetName="Glow" Property="Opacity" Value="0.3" /><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0" To="0.3" Duration="0:0:0.150" FillBehavior="Stop" /></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Glow" Property="Opacity" Value="0.9" /><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" From="0.3" To="0.9" Duration="0:0:0.150" FillBehavior="Stop" /></Storyboard></BeginStoryboard></Trigger.EnterActions></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ResetButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
        <Setter Property="Content" Value="Reset" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <!-- a template (not a shared element): each button builds its own icon + label -->
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding}" Style="{StaticResource CaseText}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- the one primary action: solid fill, readable text (ink on orange/yellow, white on the darker colours) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{DynamicResource ChipFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
        <Setter Property="Height" Value="46" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding}" Style="{StaticResource CaseText}" VerticalAlignment="Center" />
                        <TextBlock Text="{DynamicResource ArrowGlyph}" FontFamily="Segoe UI Symbol" FontSize="16" Margin="10,0,0,0" VerticalAlignment="Center"
                                   Visibility="{DynamicResource ArrowVisibility}" />
                    </StackPanel>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid><Border x:Name="Glow" Margin="-6" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource PrimaryBrush}" CornerRadius="{DynamicResource ButtonCorner}"><Border.Effect><BlurEffect Radius="16" /></Border.Effect></Border><Border x:Name="Chrome" Background="{DynamicResource PrimaryBrush}" CornerRadius="{DynamicResource ButtonCorner}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border><Border x:Name="Flash" Opacity="0" IsHitTestVisible="False" Background="White" CornerRadius="{DynamicResource ButtonCorner}" /></Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" /><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.150" /></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.300" /></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
<Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.06" /><DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity" To="0.35" Duration="0:0:0.06" /></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.45" /><DoubleAnimation Storyboard.TargetName="Flash" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.45" /></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Stop">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BadBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource OnStatusBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== standard controls in Streamsthetic's look ===================== -->
    <Style TargetType="CheckBox">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="Box" Width="17" Height="17" CornerRadius="3" BorderThickness="1.5"
                                BorderBrush="{DynamicResource Ink3Brush}" Background="Transparent" VerticalAlignment="Center">
                            <Path x:Name="Mark" Data="M3.5,8.5 L7,12 L13.5,4.5" Stroke="{DynamicResource OnAccentBrush}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"
                                  Margin="-1.5" />
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink2Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="17" Height="17" VerticalAlignment="Center">
                            <Ellipse x:Name="Ring" Stroke="{DynamicResource Ink3Brush}" StrokeThickness="1.5" />
                            <Ellipse x:Name="Dot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                        <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ink2Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- slider: thin track, accent fill up to the value, a small upright ink thumb -->
    <Style x:Key="SliderTrackPart" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Rectangle Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{TemplateBinding Background}" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="26">
                    <TickBar Placement="Top" Height="5" VerticalAlignment="Top" Fill="{DynamicResource Ink3Brush}" TickFrequency="1" ReservedSpace="8"
                             Visibility="{DynamicResource TicksVisibility}" />
                    <Track x:Name="PART_Track" Height="22" VerticalAlignment="Bottom">
                        <Track.DecreaseRepeatButton>
                            <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderTrackPart}" Background="{Binding Path=(skin:Skin.SectionBrush), RelativeSource={RelativeSource TemplatedParent}}" />
                        </Track.DecreaseRepeatButton>
                        <Track.IncreaseRepeatButton>
                            <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderTrackPart}" Background="{DynamicResource TrackBrush}" />
                        </Track.IncreaseRepeatButton>
                        <Track.Thumb>
                            <Thumb x:Name="Thumb">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border x:Name="Knob" Width="8" Height="18" CornerRadius="2" Background="{DynamicResource InkBrush}" />
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="Knob" Property="Background" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- text box: outlined, accent outline while typing -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource InkBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Box" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HairlineBrush}"
                            BorderThickness="1" CornerRadius="{DynamicResource ChipCorner}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink3Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- list of rows (Report a problem): the chosen row gets an accent bar and a soft fill -->
    <Style x:Key="RowItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" Padding="10,7">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipHoverBrush}" />
                            <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- status chip: small filled tag (LIVE, STOPPED...), text from OnStatusBrush -->
    <Style x:Key="StatusChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource ChipCorner}" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

    <!-- ===================== dropdown (any setting with 3 or more choices) ===================== -->
    <Style x:Key="DropdownItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{DynamicResource ChipFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row" Padding="12,8" CornerRadius="6" Margin="3,1" Background="Transparent">
                        <Grid>
                            <ContentPresenter VerticalAlignment="Center" />
                            <Ellipse x:Name="Dot" Width="6" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource ChipHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Dropdown" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{DynamicResource ChipFont}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="Width" Value="176" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource DropdownItem}" />
        <Setter Property="ItemTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CaseText}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="Glow" Margin="-3" Opacity="0" IsHitTestVisible="False" Background="{DynamicResource AccentBrush}" CornerRadius="{DynamicResource ChipCorner}">
                            <Border.Effect><BlurEffect Radius="10" /></Border.Effect>
                        </Border>
                        <Border x:Name="Chrome" Background="{DynamicResource ChipFillBrush}" BorderBrush="{DynamicResource ChipStrokeBrush}"
                                BorderThickness="{DynamicResource ChipBorder}" CornerRadius="{DynamicResource ChipCorner}" Effect="{DynamicResource ChipEffect}" />
                        <ToggleButton x:Name="Toggle" Background="Transparent" Focusable="False" ClickMode="Release"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" /></ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid IsHitTestVisible="False" Margin="12,0,10,0" MinHeight="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                            <Path Grid.Column="1" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource Ink2Brush}" StrokeThickness="1.6" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                               Focusable="False" PopupAnimation="Fade" VerticalOffset="4">
                            <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,0,14,14" Padding="3"
                                    Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="1"
                                    CornerRadius="10" MaxHeight="320">
                                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.35" Color="#000000" /></Border.Effect>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" /></ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ChipHoverBrush}" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.25" Duration="0:0:0.15" /></Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" FillBehavior="Stop" /></Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== settings tabs (underlined tab strip, like Elgato Studio's Recording / Device) ===================== -->
    <Style x:Key="SettingsTab" TargetType="TabItem">
        <Setter Property="FontFamily" Value="{DynamicResource TitleFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" Style="{StaticResource CaseText}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bar" Padding="16,10" Margin="0,0,4,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                            <Setter TargetName="Bar" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsTab}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{DynamicResource HairlineBrush}" BorderThickness="0,0,0,1">
                            <TabPanel IsItemsHost="True" Background="Transparent" />
                        </Border>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- one setting row: a thin divider under it, like Swivel's option lists; RowHint = the short description under a row title -->
    <Style x:Key="RowRule" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0,0,0,11" />
        <Setter Property="Margin" Value="0,0,0,11" />
    </Style>
    <Style x:Key="RowHint" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource SansFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Ink2Brush}" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
