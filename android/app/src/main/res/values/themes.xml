<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follows light/dark (the system setting, or the app's own Appearance choice on Android 12+).
         The previous theme, DeviceDefault.NoActionBar, was dark only. -->
    <style name="PhoneCamTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
